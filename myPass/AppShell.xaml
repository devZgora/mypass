<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="myPass.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:myPass"
    xmlns:viewMmodel="clr-namespace:myPass.ViewModels"
    x:DataType="viewMmodel:ShellViewModel"
    Title="myPass">
    <TabBar >
        <ShellContent
        Title="Home"  Icon="dotnet_bot.png" 
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
        <ShellContent
        Title="About"
        ContentTemplate="{DataTemplate local:About}"
        Route="About" />
    </TabBar>
</Shell>
